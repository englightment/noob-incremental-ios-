# NoobIncremental.xcodeproj IS committed — Xcode Cloud needs a real project file in the
# repo to detect a scheme; CI keeps it in sync (see the sync-xcodeproj job in ios.yml).
# User-specific junk inside it is still ignored below.

# Scratch tooling used to generate assets (e.g. browser-canvas app icon export) — not part of the app
.icon-gen/

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
.build/

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/

# Fastlane (once added)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
